@echo off
setlocal EnableExtensions DisableDelayedExpansion
title Gerador de PDF - Plano Matematico

set "PM_HTML=%~f1"

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -EncodedCommand 

set "RC=%ERRORLEVEL%"
echo.
if "%RC%"=="0" (
  echo Processo concluido.
) else (
  echo O gerador encontrou um erro. Veja a mensagem acima.
)
echo.
pause
exit /b %RC%
